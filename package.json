{
  "name": "7xen-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "7XEN Studio — standalone live production for a venue PC: phones over Wi-Fi, scenes, record + stream (no AirBattleground dependency)",
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.59.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.460.0",
    "playwright-core": "1.59.1",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  }
}
