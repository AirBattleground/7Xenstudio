# 7XEN Studio settings. Copy to .env (read by `pnpm dev`, `pnpm start` and docker compose). Everything is optional.

# web app + API port (LAN)
PORT=4400
# address phones and other PCs use; auto-detected (first private IPv4) when empty
LAN_HOST=
# full URL override, e.g. http://studio.local:4400
LAN_URL=
# default studio name (Settings can change it)
STUDIO_NAME=7XEN Studio
# when set, the web app asks for this PIN once per browser
STUDIO_PIN=
# store.json, secret, props/, recordings/
DATA_DIR=./data
# the built web app (pnpm build)
WEB_DIST=./dist/web

# MediaMTX (docker compose). Keep these in step with the ports below.
MEDIA_RTMP_PORT=1940
MEDIA_HLS_PORT=8893
MEDIA_API_PORT=9994
MEDIA_HLS_URL=http://127.0.0.1:8893
MEDIA_API_URL=http://127.0.0.1:9994

# renderer: ffmpeg / Chrome paths (auto when empty) and a forced encoder (h264_nvenc, h264_qsv, h264_amf, h264_videotoolbox, libx264)
FFMPEG_PATH=
CHROME_PATH=
ENCODER=
# extra Chrome flags for the renderer (space separated)
CHROME_ARGS=
